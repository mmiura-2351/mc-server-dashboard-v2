# Environment for the single-host compose deployment (issue #189).
# Copy to .env and fill every value: `cp .env.example .env`.
# .env is gitignored — it holds secrets and host-specific values. Never commit it.

# --- Compose project name (issue #2609) ------------------------------------
# Leave this unset for a normal deployment: compose.yaml pins the project to
# `mcsd`, which is what makes the networks `mcsd` and `mcsd-servers`.
# Set it only to run a SECOND stack beside an existing one — it renames the
# networks (`<name>`, `<name>-servers`), the volumes (`<name>_db-data`, ...) and
# the containers, which is exactly what keeps the two apart. Setting it on a
# live deployment therefore moves that deployment onto different volumes and
# networks; see docs/dev/DEPLOYMENT.md Section 9 before you do.
# COMPOSE_PROJECT_NAME=

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=mcsd
POSTGRES_DB=mcsd
# Database password (the api's DB URL is built from it). You MUST set a real
# value: blank/unset makes compose REFUSE to start (the `:?` interpolation in
# compose.yaml). Generate one, e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- API secrets -----------------------------------------------------------
# JWT signing key for access/refresh tokens. HS256 requires >= 32 bytes.
# You MUST set a real value: blank/unset makes compose REFUSE to start (the
# `:?` interpolation in compose.yaml), so the api never boots with an empty key.
# Generate: openssl rand -base64 48
MCD_API_AUTH__TOKEN__SIGNING_KEY=

# Shared secret the worker presents to authenticate its control-plane stream.
# The worker uses this same value (MCD_WORKER_API_CREDENTIAL in compose.yaml).
# You MUST set a real value: blank/unset makes compose REFUSE to start (the
# `:?` interpolation in compose.yaml), so the control plane never admits an
# unauthenticated worker. Generate: openssl rand -base64 48
MCD_API_CONTROL__WORKER_CREDENTIAL=

# --- Public base URL (issue #1554) -----------------------------------------
# The externally reachable origin for this deployment. MUST be set for any
# real deployment: player-facing links (e.g. resource-pack download URLs)
# are rendered from this value. Leaving it commented out falls back to
# compose's internal default (http://api:8000), reachable only on the
# `mcsd` network, which silently renders those links unreachable.
# See docs/dev/DEPLOYMENT.md Section 3 (and "Cloudflare Tunnel" for a worked
# example).
# MCD_API_SERVER__PUBLIC_BASE_URL=https://mc.example.com

# --- Worker data-plane base URL (issue #1549) ------------------------------
# The address the API hands Workers for hydrate/snapshot transfers. Unlike
# the client-facing PUBLIC_BASE_URL above, compose.yaml PINS this one to the
# internal http://api:8000 whatever PUBLIC_BASE_URL is set to, so a co-located
# worker's uploads never hairpin through a body-size-capped edge (e.g.
# Cloudflare Tunnel, ~100 MB). That address resolves only on the compose
# network, so a Worker on ANOTHER host means OVERRIDING it here with an
# address that worker can reach: the API host's LAN/VPN address, not the
# tunnel hostname, on the published host port (API_HTTP_PORT below, not the
# container's internal 8000). That port binds loopback by default, so
# API_HTTP_BIND_IP below has to move to an interface that worker can reach
# too. Nothing warns at startup, because compose always sets the variable;
# the first signal is a failed hydrate/snapshot.
# See docs/dev/DEPLOYMENT.md Section 8 ("The data-plane URL for a
# cross-host worker").
# MCD_API_SERVER__DATA_PLANE_BASE_URL=http://10.0.0.5:8000

# --- Storage backend (issue #702, #940) ------------------------------------
# The shipped default is the `object` backend on the in-compose SeaweedFS S3
# gateway (STORAGE.md Section 7.3). The `seaweedfs` service is gated behind the
# `object` compose profile; COMPOSE_PROFILES below activates it by default, so the
# default experience is "nothing extra to do" — seaweedfs runs and the two S3 keys
# below are required.
#
# COMPOSE_PROFILES selects which profile-gated services run. Leave it as `object`
# for the default object backend. Set it EMPTY (COMPOSE_PROFILES=) together with
# MCD_API_STORAGE__BACKEND=fs to opt back to the local-volume fs backend: that
# drops the seaweedfs service entirely and frees you from the two S3 keys below
# (see docs/dev/DEPLOYMENT.md "Opting back to the fs backend").
COMPOSE_PROFILES=object
#
# The two keys below are the S3 credentials, shared by the api (client) and the
# seaweedfs service (which writes its S3 identities file from them at startup).
# With the default `object` profile active you MUST generate real values: blank
# keys fail loudly at boot — the seaweedfs entrypoint refuses a blank-key identities
# file, and the api's _build_storage refuses the object backend with blank creds
# (naming the variables) — because SeaweedFS authenticates blank-credential clients
# and would otherwise boot a silently unauthenticated store. Generate both, e.g.:
#   openssl rand -hex 16    # access key
#   openssl rand -hex 32    # secret key
# Rotate by changing both values here and recreating the api + seaweedfs services
# (`docker compose up -d --force-recreate api seaweedfs`); existing objects are
# unaffected since the credentials only gate API access, not object encryption.
# (In fs mode these keys are unused; leave them blank.)
MCD_API_STORAGE__OBJECT__ACCESS_KEY=
MCD_API_STORAGE__OBJECT__SECRET_KEY=
# Bucket name (auto-created on first write). Override only if you must.
# MCD_API_STORAGE__OBJECT__BUCKET=mcsd
#
# fs opt-out: edit the COMPOSE_PROFILES line above to COMPOSE_PROFILES= (empty)
# AND add or uncomment: MCD_API_STORAGE__BACKEND=fs
# (see docs/dev/DEPLOYMENT.md "Opting back to the fs backend").
# WARNING: if you set MCD_API_STORAGE__BACKEND=fs but leave COMPOSE_PROFILES=object
# active with blank S3 keys, seaweedfs will FATAL-loop and the api will block on
# its healthy-wait — set COMPOSE_PROFILES= (empty) too.
# MCD_API_STORAGE__BACKEND=fs

# --- Worker / container driver --------------------------------------------
# Absolute host path for the worker scratch dir. It is bind-mounted at the SAME
# path inside the worker container (the Docker daemon resolves MC-server binds
# against host paths), so it must be an absolute path.
MCSD_SCRATCH_DIR=/opt/mcsd/scratch

# Host interface on which the worker publishes each server's game port.
# Default (unset / 0.0.0.0): all interfaces — players connect directly to this host.
# Relay path: set to 127.0.0.1 so game ports bind loopback-only; the Worker dials
# its own loopback into the tunnel and no inbound game-port range is needed.
# MCD_WORKER_GAME_BIND_IP=127.0.0.1

# --- Relay (epic #659, issue #960) -----------------------------------------
# The game ingress relay is opt-in. To enable it, add `relay` to
# COMPOSE_PROFILES above (e.g. COMPOSE_PROFILES=object,relay) and fill the
# required variables below. See docs/dev/DEPLOYMENT.md "Relay" for full setup
# (wildcard DNS, TLS material, worker game_bind_ip guidance).
#
# Shared secret the relay presents to authenticate against the API RelayService.
# Also set on the relay side as MCD_RELAY_API_CREDENTIAL (see compose.yaml).
# compose uses `:-` so it does NOT refuse a blank value here — the relay binary
# itself fails fast at startup when this is empty. Generate: openssl rand -base64 48
MCD_API_RELAY__CREDENTIAL=
#
# Master switch on the API side. Set true to serve RelayService, expose
# join_hostname per server, and run the session prune loop.
# (API config key: relay.enabled — env_prefix=MCD_API_, delimiter=__)
MCD_API_RELAY__ENABLED=false
#
# Base domain for the wildcard DNS record, e.g. mc.example.com. The API builds
# per-server join hostnames as <slug>.<base_domain>.
# (API config key: relay.base_domain — env_prefix=MCD_API_, delimiter=__)
MCD_API_RELAY__BASE_DOMAIN=
#
# Bedrock ingress capability gate (epic #1540, issue #1541). Set true to let
# Geyser detection allocate a server's bedrock_port and surface
# bedrock_address/bedrock_port on server responses; also publish the relay's
# Bedrock UDP ports (see compose.yaml's relay service) and open the inbound UDP
# window on the relay host firewall. See docs/app/BEDROCK.md and
# docs/dev/DEPLOYMENT.md "Relay" for the full setup and manual verification.
# This one flag now also gates the relay's own Bedrock QUIC/UDP tunnel
# listener (compose.yaml feeds it to the relay as MCD_RELAY_BEDROCK_ENABLED,
# default false) so a Java-only relay neither binds nor requires the Bedrock
# UDP ports on upgrade (issue #1584).
# (API config key: relay.bedrock_enabled — env_prefix=MCD_API_, delimiter=__)
MCD_API_RELAY__BEDROCK_ENABLED=false
#
# The tunnel endpoint (host:port) advertised to Workers so they know where to
# dial back. For the in-compose Worker this is `relay:25665` — the relay's
# address on the internal `mcsd` network, which needs no host publication at
# all. Use a host address only when a Worker runs on ANOTHER machine, and then
# set RELAY_CONTROL_BIND_IP below to that same address (issue #2627). The
# tunnel cert's SAN must match the hostname part either way — see
# docs/dev/DEPLOYMENT.md "Relay — TLS material".
# Must be non-empty when the `relay` profile is active.
MCD_RELAY_TUNNEL_PUBLIC_ENDPOINT=
#
# Host interface on which the relay's Worker dial-back port is published
# (compose.yaml binds ${RELAY_CONTROL_BIND_IP}:25665:25665). Default (unset /
# 127.0.0.1): loopback only — nothing off this host reaches the dial-back port,
# and neither do the Minecraft containers, which can otherwise reach any
# interface-published port through the docker bridge gateway even though
# network segmentation keeps them off the relay's own network (issue #2627,
# docs/app/SECURITY.md Section 6).
# Set it to an address a cross-host Worker can reach when you run one, together
# with MCD_RELAY_TUNNEL_PUBLIC_ENDPOINT above (docs/dev/DEPLOYMENT.md
# Section 8).
# Only 25665 is bind-scoped: 25565, 25675/udp and 19132-19231/udp stay
# published on every interface, and SECURITY.md Section 6 records that
# residual.
# RELAY_CONTROL_BIND_IP=10.0.0.5
#
# Host directory containing tunnel-cert.pem and tunnel-key.pem (the relay's
# tunnel listener TLS material). Bind-mounted read-only into the relay container
# at /etc/mcsd/. Self-signed is fine; the CA travels in-band to Workers.
# Generate once: see docs/dev/DEPLOYMENT.md "Relay — TLS material".
MCD_RELAY_TLS_DIR=/etc/mcsd/relay

# --- Cloudflare Tunnel (optional, issue #1090) -----------------------------
# Cloudflare Tunnel provides HTTPS access to the dashboard without opening
# inbound ports or managing TLS certificates. The tunnel is configured in the
# Cloudflare Zero Trust dashboard (https://one.dash.cloudflare.com/).
#
# To enable: add `tunnel` to COMPOSE_PROFILES above (e.g. COMPOSE_PROFILES=object,tunnel)
# and set the tunnel token below.
#
# Create a tunnel in the Cloudflare dashboard, add a public hostname pointing to
# `http://api:8000`, and copy the tunnel token here.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Published host ports --------------------------------------------------
# Host port for the API HTTP surface (REST + data-plane). The gRPC control
# plane (50051) is not published: the in-compose worker reaches it over the
# internal network. A cross-host worker requires control-plane TLS first
# (see docs/dev/DEPLOYMENT.md).
API_HTTP_PORT=8000
# Host interface on which the API HTTP port is published (compose.yaml binds
# ${API_HTTP_BIND_IP}:${API_HTTP_PORT}:8000). Default (unset / 127.0.0.1):
# loopback only — the API is reachable only from the host itself (or from
# cloudflared / a reverse proxy running on the same host).
# Set to 0.0.0.0 when the API must be reachable directly from the network
# (e.g. no tunnel, no reverse proxy, or the reverse proxy runs on a different
# host).
# API_HTTP_BIND_IP=0.0.0.0
#
# The two above are the HOST side. The CONTAINER side — what the API process
# actually binds — is the settings below (issue #2585); the image's entry
# command passes no --host/--port of its own, so these are the bind. Leave them
# alone unless you have a reason: compose derives the publish target above, the
# healthcheck and the internal http://api:... URLs handed to the worker from the
# port, so moving it moves them together, but the `http://api:8000` target
# configured in the Cloudflare dashboard has to be changed by hand.
# MCD_API_SERVER__HOST=0.0.0.0 is also the value to KEEP under compose: the bind
# happens inside the container's network namespace, so loopback there leaves the
# published port unreachable from the host while the healthcheck (which probes
# container-localhost) still reports healthy.
# MCD_API_SERVER__HOST=0.0.0.0
# MCD_API_SERVER__HTTP_PORT=8000

# --- Prometheus metrics (issue #2565) --------------------------------------
# The Prometheus exposition is served on its OWN listener, never on the API
# HTTP port above: cloudflared forwards the whole public hostname to api:8000,
# so a route there is a route on the internet. Off by default; nothing binds.
# Uncomment to bind it, then scrape http://api:9090/metrics from a service on
# the `mcsd` network (not `mcsd-servers`, where the Minecraft containers run —
# issue #2590). compose.yaml deliberately does NOT publish that port —
# do not add it to `ports:`, and do not give it a Cloudflare public hostname.
# MCD_API_METRICS__ENABLED=true
#
# The listener binds 0.0.0.0 by default, and under compose that is the value to
# keep: the bind happens inside the container's own network namespace, so
# loopback there would make the endpoint unscrapeable by any sibling service,
# while what actually keeps it private is the missing `ports:` entry. Changing
# the port is the only one of these two you are likely to want here.
# MCD_API_METRICS__HOST=0.0.0.0
# MCD_API_METRICS__PORT=9090
#
# NOTE for non-compose runs (bare metal, systemd — where API_HTTP_BIND_IP has no
# meaning, since it is only compose's `ports:` interpolation): there 0.0.0.0 IS
# a network-reachable second port, and a reverse proxy in front of the API's
# HTTP port does not cover it. Set MCD_API_METRICS__HOST to 127.0.0.1 or a
# private interface, or firewall the port. See docs/dev/DEPLOYMENT.md Section 8
# and docs/app/SECURITY.md Section 5.

# --- Logging (issue #2794) -------------------------------------------------
# Verbosity and format of each service's structured logs. Unset, all three log
# `info` in `json`; compose forwards all six names, so turning verbosity up for
# an incident is an edit here plus `docker compose up -d <service>`, never an
# edit to compose.yaml. It has to be `up -d` (which recreates the container on
# the changed environment) and NOT `docker compose restart`, which restarts the
# existing container with the environment it was created from and would show you
# no change at all.
#
# Mind the two spellings: the api's keys are NESTED, so its names carry a double
# underscore (LOG__LEVEL); the Go services' are flat (LOG_LEVEL). The accepted
# levels differ by one word too — the api takes `warning`, the Go services take
# `warn`. Both take `json` or `text` as the format.
#
# api — debug | info | warning | error
# MCD_API_LOG__LEVEL=debug
# MCD_API_LOG__FORMAT=text
# worker, relay — debug | info | warn | error
# MCD_WORKER_LOG_LEVEL=debug
# MCD_WORKER_LOG_FORMAT=text
# MCD_RELAY_LOG_LEVEL=debug
# MCD_RELAY_LOG_FORMAT=text

# --- Reconciler tuning (issue #985) ----------------------------------------
# After an API restart, servers whose observed state was reset to unknown
# stay unjoinable via the relay for the full grace window (issue #985).
# To speed self-heal on single-host deployments where the worker reconnects
# in seconds, lower HELD_START_GRACE_SECONDS (default 90 s). This shortens
# the grace only for servers whose start was already held by the API, which
# is the common restart case; the full GRACE_SECONDS (660 s) still protects
# cold starts that may need hydrate + snapshot time.
# Do NOT lower GRACE_SECONDS below its safety floor (~630 s) — doing so
# triggers a boot-time warning and risks duplicate-start / stale-snapshot
# races.  See docs/dev/DEPLOYMENT.md Section 12 for details.
# MCD_API_RECONCILER__GRACE_SECONDS=660
# MCD_API_RECONCILER__HELD_START_GRACE_SECONDS=90
# REFUSED_STOP_GRACE_SECONDS (issue #2478) is the short grace for replaying a
# stop the worker REFUSED. A returned refusal ends the round trip GRACE_SECONDS
# budgets for, so there is nothing left to outlast and this knob has no safety
# floor; a stop divergence with no recorded refusal still waits GRACE_SECONDS.
# MCD_API_RECONCILER__REFUSED_STOP_GRACE_SECONDS=30
# MCD_API_RECONCILER__INTERVAL_SECONDS=60
# MCD_API_RECONCILER__BACKOFF_BASE_SECONDS=30
# MCD_API_RECONCILER__BACKOFF_MAX_SECONDS=3600

# --- Game-port range (issue #1002) -----------------------------------------
# Inclusive range the API auto-assigns each server's game port from. Defaults
# match the built-in window (25565..25664). In relay mode the API already
# excludes any relay host binds that fall inside this range (by default just
# game 25565; the tunnel's 25665 sits above range_end and is therefore inert),
# so this is only a fallback knob for shifting the range. Leave commented to
# use the defaults.
# MCD_API_PORTS__RANGE_START=25565
# MCD_API_PORTS__RANGE_END=25664
