{
  "name": "webui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": "11.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "bench": "vitest bench",
    "e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "openapi:export": "cd ../api && uv run python -m mc_server_dashboard_api.export_openapi ../webui/openapi.json",
    "openapi:generate": "npm --prefix ./tools/openapi run generate",
    "openapi": "npm run openapi:export && npm run openapi:generate"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.11.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
