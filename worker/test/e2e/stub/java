#!/bin/sh
# Create Forge launch artifacts for install invocations; otherwise wait for SIGTERM.
# PID 1 needs an explicit signal trap so docker stop can terminate it promptly.

for arg in "$@"; do
	if [ "$arg" = "--installServer" ]; then
		# The driver accepts any version directory but requires exactly one match.
		dir="libraries/net/minecraftforge/forge/0.0.0-stub"
		mkdir -p "$dir"
		printf 'stub forge args file\n' >"$dir/unix_args.txt"
		echo "stub forge installer: wrote $dir/unix_args.txt"
		exit 0
	fi
done

trap "exit 0" TERM INT
while true; do
	sleep 1 &
	wait $!
done
