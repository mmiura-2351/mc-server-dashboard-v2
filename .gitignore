# Local deployment environment: holds secrets and host-specific values.
# Only the committed template (.env.example) is tracked.
.env

# Python bytecode left behind by running scripts/*.py directly.
scripts/__pycache__/
scripts/*.py[cod]

# Written by scripts/deploy.sh and scripts/update.sh: the revision the running
# stack was built and started from, and whether that revision passed the
# post-deploy healthcheck. Separate files because they are separate facts -- a
# stack that started but never answered /api/healthz is still running the new
# revision, which is what change detection diffs against (#2311).
.last-deploy-sha
.last-deploy-health

# Written by scripts/pg_major_upgrade.sh while the db-data volume has been
# released and the new cluster is not yet restored; removed once it is. Its
# presence is how a re-run tells a partially-restored cluster from a finished
# upgrade (both are just "the volume holds PostgreSQL <target>").
.pg-upgrade-incomplete

# An operator's own compose customisation, such as the api service's stop grace
# and shutdown drain (docs/dev/DEPLOYMENT.md Section 9, issue #4109). docker
# compose merges it beside compose.yaml; ignored so that the deploy preflight's
# clean-tree check (scripts/deploy_preflight.sh) does not refuse a checkout
# that has one.
compose.override.yaml
