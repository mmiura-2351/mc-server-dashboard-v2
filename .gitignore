# Local deployment environment: holds secrets and host-specific values.
# Only the committed template (.env.example) is tracked.
.env

# Python bytecode left behind by running scripts/*.py directly.
scripts/__pycache__/
scripts/*.py[cod]

# Deployed commit stamp written by scripts/update.sh.
.last-deploy-sha

# Written by scripts/pg_major_upgrade.sh while the db-data volume has been
# released and the new cluster is not yet restored; removed once it is. Its
# presence is how a re-run tells a partially-restored cluster from a finished
# upgrade (both are just "the volume holds PostgreSQL <target>").
.pg-upgrade-incomplete
